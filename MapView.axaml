<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:paz="using:Avalonia.Controls.PanAndZoom"
        x:Class="map_app.MapView"
        Title="Редактор карты графа"
        Width="1200" Height="800">

    <Grid RowDefinitions="Auto, *">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10" Background="#2D2D2D">
            <Button Content="Сбросить зум" Click="OnResetZoomClick"/>
            <Button Content="Сохранить JSON" Click="OnSaveJsonClick"/>
            <Button Content="Очистить всё" Click="OnClearGraphClick"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="LightGray" Margin="10,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <paz:ZoomBorder x:Name="ZoomControl"
                            PanButton="Middle"
                            ZoomSpeed="1.2"
                            Stretch="None"
                            EnableConstrains="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#1E1E1E">
                
                <Grid x:Name="MapContainer" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="MapImage" Stretch="None"/>
                    <Canvas x:Name="GraphCanvas" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerPressed="OnCanvasPointerPressed"/>
                </Grid>
                
            </paz:ZoomBorder>

            <Grid x:Name="EditNodeOverlay" Background="#80000000" IsVisible="False">
                <Border Background="#2D2D2D" Padding="20" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="OverlayTitle" Text="Новая точка" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        
                        <TextBlock Text="Тип точки:" Foreground="Gray" FontSize="12"/>
                        <ComboBox x:Name="NodeTypeComboBox" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnNodeTypeChanged">
                            <ComboBoxItem Content="road"/>
                            <ComboBoxItem Content="waypoint"/>
                            <ComboBoxItem Content="entrance"/>
                            <ComboBoxItem Content="stairs"/>
                            <ComboBoxItem Content="ramp"/>
                        </ComboBox>

                        <StackPanel x:Name="NamePanel" Spacing="5" IsVisible="False">
                            <TextBlock Text="Название (Name):" Foreground="Gray" FontSize="12"/>
                            <TextBox x:Name="NodeNameInput" Watermark="Например: Главный корпус"/>
                        </StackPanel>

                        <StackPanel x:Name="EntrancePanel" Spacing="10" IsVisible="False">
                            <CheckBox x:Name="NodeAccessibleCheckBox" Content="Доступно для инвалидов (Accessible)"/>
                            <TextBlock Text="Связанный Waypoint (Building ID):" Foreground="Gray" FontSize="12"/>
                            <ComboBox x:Name="BuildingWaypointsComboBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,10,0,0">
                            <Button Grid.Column="0" x:Name="DeleteNodeButton" Content="Удалить" Background="#B00020" Foreground="White" Click="OnDeleteNodeClick"/>
                            
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                                <Button Content="Отмена" Click="OnCancelNodeEdit"/>
                                <Button Content="Сохранить" Click="OnSaveNodeEdit"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="EditEdgeOverlay" Background="#80000000" IsVisible="False">
                <Border Background="#2D2D2D" Padding="20" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="EdgeOverlayTitle" Text="Связь" Foreground="White" FontWeight="Bold" FontSize="16"/>

                        <TextBlock Text="Время прохождения (секунды):" Foreground="Gray" FontSize="12"/>
                        <TextBox x:Name="EdgeTimeInput" Watermark="Например: 30"/>
                        <TextBlock x:Name="EdgeTimeError" Text="Введите неотрицательное число." Foreground="#FF6B6B" FontSize="12" IsVisible="False"/>

                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,0">
                            <Button Grid.Column="0" Content="Удалить" Background="#B00020" Foreground="White" Click="OnDeleteEdgeClick"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                <Button Content="Отмена" Click="OnCancelEdgeEdit"/>
                                <Button Content="Сохранить" Click="OnSaveEdgeEdit"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>